# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Memory Box — build artifacts that are NOT committed (rebuilt on the
# build machine; the GitHub snapshot push cannot carry binaries at all):
# - Android sqlite-vec .so files: rebuild with
#   spikes/sqlitevec_spike/android/build_vec0.sh (needs the Android NDK).
android/app/src/main/jniLibs/**/*.so
# - Windows yt-dlp.exe / ffmpeg.exe: place in windows/tools/ before a
#   Windows build (see windows/CMakeLists.txt). Never commit the .exe files.
windows/tools/*.exe
# - ONNX embedding model + tokenizer (assets/models/): large binaries,
#   downloaded separately (see lib/api/embeddings.dart).
assets/models/
# - Local databases (the app's own .db, test outputs).
*.db
*.db-journal
*.db-wal
*.db-shm

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
