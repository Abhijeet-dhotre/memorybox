<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MemoryBox" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/ios_bg_grouped</item>
        <item name="colorPrimary">@color/ios_tint_blue</item>
        <item name="colorPrimaryVariant">@color/ios_bg_grouped</item>
        <item name="colorOnPrimary">@color/ios_surface_card</item>
        <!-- Edge-to-edge clean status bar -->
        <item name="android:statusBarColor">@color/ios_bg_grouped</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/ios_bg_grouped</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.MemoryBox.Popup" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
